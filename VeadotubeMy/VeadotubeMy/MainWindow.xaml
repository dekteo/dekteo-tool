<Window x:Class="VeadotubeMy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VeadotubeMy.Views"
        Title="Dekteo Tool"
        Height="840" Width="1180" MinHeight="680" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Grid>
        <Border Background="{DynamicResource SceneBackgroundBrush}" CornerRadius="0"/>
        <!-- ================= LEFT TOOLBAR ================= -->
        <Border x:Name="LeftPanelBorder" HorizontalAlignment="Left" Width="0" Margin="0" ClipToBounds="True" Panel.ZIndex="5"
                Background="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="LeftToolbar" Margin="0">
                        
                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                        <Button Content="⋯" Padding="0" Width="32" DockPanel.Dock="Right" Tag="mic" Click="OpenSettings_Click" Height="32" FontSize="15" ToolTip="Выбрать микрофон и настроить звук"/>
                        
                        </DockPanel>
                        <Border Height="1" Background="Transparent" Margin="0,8"/>
                        
                        
                        <ToggleButton x:Name="BtnEyes" Visibility="Collapsed"  Tag="eyes" FontSize="12" Height="32" Margin="0,12,0,4"
                                      Checked="TglFunction_Checked" Unchecked="TglFunction_Unchecked"
                                      PreviewMouseRightButtonDown="BtnEyes_RightClick" ToolTip="Автоматическое моргание"><StackPanel Orientation="Horizontal"><Path Data="M 1,12 Q 12,-2 23,12 Q 12,26 1,12 Z M 15,12 A 3,3 0 1 1 9,12 A 3,3 0 1 1 15,12" Stroke="#DCE8F5" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="Моргание" VerticalAlignment="Center"/></StackPanel></ToggleButton>
                        <Button x:Name="BtnBlinkSettings" Visibility="Collapsed" Content="Настроить моргание" Tag="blink" Click="OpenSettings_Click" Height="28" FontSize="11" ToolTip="Настройки моргания"/>
                        <ToggleButton x:Name="BtnPupils" Visibility="Collapsed"  Tag="pupils" FontSize="12" Height="32" Margin="0,16,0,4"
                                      Checked="TglFunction_Checked" Unchecked="TglFunction_Unchecked"
                                      ToolTip="Дополнительная функция: следить за курсором"><StackPanel Orientation="Horizontal"><Path Data="M 1,12 Q 12,-2 23,12 Q 12,26 1,12 Z M 18,12 A 3,3 0 1 1 12,12 A 3,3 0 1 1 18,12" Stroke="#DCE8F5" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="Зрачки" VerticalAlignment="Center"/></StackPanel></ToggleButton>
                        <Button Content="Рот · отдельный слой" Tag="mouthLayer" Click="OpenSettings_Click" Height="32" Margin="0,0,0,4"/>
                        <Button Content="✥ Руки и устройства" Tag="handsRig" Click="OpenSettings_Click" Height="32" Margin="0,0,0,4"/>
                        <Button Tag="accessories" Click="OpenSettings_Click" Height="32" Margin="0,0,0,4" ToolTip="Подвески, брелоки и другие детали персонажа">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 8,2 C 2,2 2,10 8,10 C 14,10 14,2 8,2 M 8,10 L 8,14 M 4,14 L 12,14 L 14,22 L 2,22 Z" Stroke="#DCE8F5" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Аксессуары" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Глаза" Tag="pupils" Click="OpenSettings_Click" Height="32" Margin="0,0,0,4" ToolTip="Слои левого и правого глаза, зрачки и взгляд"/>
                        <Button Content="Моргание" Tag="blink" Click="OpenSettings_Click" Height="32" ToolTip="Случайный интервал и длительность моргания для выбранного способа глаз"/>
                        <Button Content="Размещение" Tag="placement" Click="OpenSettings_Click" Height="32" Margin="0,4,0,0" ToolTip="Перемещение персонажа и головы, масштаб"/>
                        <Border Height="1" Background="Transparent" Margin="0,8"/>
                        <Button  Tag="background" Click="OpenSettings_Click" Height="32" FontSize="12" Margin="0,0,0,4" ToolTip="Фон сцены"><StackPanel Orientation="Horizontal"><Path Data="M 3,3 L 21,3 L 21,21 L 3,21 Z M 3,17 L 10,10 L 15,15 L 18,12 L 21,15" Stroke="#DCE8F5" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="Фон" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Tag="effects"  Click="OpenSettings_Click" Height="32" Margin="0,0,0,4"><StackPanel Orientation="Horizontal"><Path Data="M 12,1 L 15,9 L 23,12 L 15,15 L 12,23 L 9,15 L 1,12 L 9,9 Z" Stroke="#DCE8F5" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="Эффекты" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Tag="settings"  Click="OpenSettings_Click" Height="32" Margin="0,0,0,4"><StackPanel Orientation="Horizontal"><Path Data="M 2,5 L 22,5 M 2,12 L 22,12 M 2,19 L 22,19 M 7,2 L 7,8 M 17,9 L 17,15 M 10,16 L 10,22" Stroke="#DCE8F5" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0"/><TextBlock Text="Настройки" VerticalAlignment="Center"/></StackPanel></Button>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <Button Content="Вывод в OBS" Tag="help" Click="OpenSettings_Click" Height="30" Margin="0,0,0,4"/>

                    <Button x:Name="BtnTogglePanels" Content="Скрыть · F8" Height="32"
                            BorderBrush="#06E2EB" Click="BtnTogglePanels_Click"
                            ToolTip="Чистая сцена для OBS. Нажмите F8 в этом окне, чтобы вернуть интерфейс."/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel x:Name="BottomTools" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,10" Panel.ZIndex="20">
            <Button Content="⚙" Width="36" Height="32" Tag="settings" Click="OpenSettings_Click" ToolTip="Настройки приложения" Margin="0,0,6,0"/>
            <Button Content="✥" Width="36" Height="32" Tag="placement" Click="OpenSettings_Click" ToolTip="Переместить персонажа целиком" Margin="0,0,6,0"/>
            <Button Content="◫" Width="36" Height="32" Click="BtnTogglePanels_Click" ToolTip="Скрыть интерфейс · F8. Вернуть: F8 или щелчок по сцене"/>
        </StackPanel>
        <!-- ================= CENTRAL SCENE ================= -->
        <Grid PreviewMouseLeftButtonDown="Scene_PreviewMouseLeftButtonDown" PreviewMouseRightButtonDown="Scene_PreviewMouseRightButtonDown">
            <!-- Scene background (chromakey by default) -->
            <Border x:Name="SceneBackground" CornerRadius="0" Background="{DynamicResource SceneBackgroundBrush}"/>

            <!-- Avatar always centered -->
            <views:AvatarView x:Name="AvatarView"/>
        </Grid>

        <!-- ================= RIGHT PANEL: PNG STATES ================= -->
        <Border x:Name="RightPanelBorder" HorizontalAlignment="Left" VerticalAlignment="Top" Width="280" Margin="16,16,16,60" Panel.ZIndex="5"
                Background="#20252C" CornerRadius="12">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top">
                        <Border Background="#181D23" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                          <StackPanel>
                            <DockPanel>
                              <TextBlock Text="МИКРОФОН" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
<ToggleButton x:Name="BtnMic" Style="{StaticResource MicRailToggle}"  Tag="mic" FontSize="12" Height="26" Width="30" Margin="0"
                                      Checked="TglFunction_Checked" Unchecked="TglFunction_Unchecked"
                                      PreviewMouseRightButtonDown="BtnMic_RightClick" ToolTip="Включить или выключить микрофон"><StackPanel Orientation="Horizontal"><Path Data="M 8,2 C 8,-1 16,-1 16,2 L 16,11 C 16,16 8,16 8,11 Z M 4,10 L 4,12 C 4,22 20,22 20,12 L 20,10 M 12,20 L 12,25 M 7,25 L 17,25" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" Margin="0"/></StackPanel></ToggleButton><ToggleButton x:Name="BtnMouth" Style="{StaticResource MicRailToggle}"  Tag="mouth" FontSize="12" Height="26" Width="30" Margin="0"
                                      Checked="TglFunction_Checked" Unchecked="TglFunction_Unchecked" ToolTip="Открывать рот при речи"><StackPanel Orientation="Horizontal"><Path Data="M 2,8 Q 12,1 22,8 Q 12,24 2,8 Z M 2,8 Q 12,14 22,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" Margin="0"/></StackPanel></ToggleButton>
                              <Button Content="⚙" Width="28" Height="26" Padding="0" Tag="mic" Click="OpenSettings_Click" ToolTip="Настройки микрофона"/>
                              <TextBlock x:Name="TxtMicPercent" Text="—" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Background="#303B49" Height="10" CornerRadius="5" Margin="0,7,0,5" ClipToBounds="True">
                              <Rectangle x:Name="MicLevelFill" Fill="#06E2EB" RadiusX="4" RadiusY="4" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="MicLevelScale" ScaleX="0"/></Rectangle.RenderTransform>
                              </Rectangle>
                            </Border>
                            <TextBlock x:Name="TxtMicState" Text="Выкл" FontSize="11" Foreground="#A7B5C8"/>
                            <Grid Margin="0,8,0,0">
                              <TextBlock Text="Порог речи" FontSize="11"/>
                              <TextBlock Text="{Binding Value, ElementName=SceneThreshold, StringFormat={}{0:0}%}" HorizontalAlignment="Right" FontSize="11"/>
                            </Grid>
                            <Slider x:Name="SceneThreshold" Style="{StaticResource RailSlider}" Minimum="0" Maximum="100" Value="20" Height="20" ValueChanged="SceneThreshold_Changed" ToolTip="Уровень звука, при котором открывается рот"/>
                            <Grid Margin="0,3,0,0"><TextBlock Text="Задержка рта" FontSize="11"/><TextBlock HorizontalAlignment="Right" FontSize="11" Text="{Binding Value, ElementName=SceneDelay, StringFormat={}{0:0} мс}"/></Grid>
                            <Slider x:Name="SceneDelay" Style="{StaticResource RailSlider}" Minimum="0" Maximum="2000" Height="16" ValueChanged="SceneDelay_Changed" ToolTip="Как долго рот остаётся открытым после снижения звука ниже порога. Это не задержка захвата микрофона."/>
                          </StackPanel>
                        </Border>
                <TextBlock Text="ПЕРСОНАЖИ" FontSize="11" Foreground="#8B9A9D" Margin="4,10,0,6"/>
                <ComboBox x:Name="EmotionList" SelectionChanged="EmotionList_SelectionChanged"
                          ToolTip="Выберите персонажа" Margin="0,0,0,6">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                    <Button Content="+ Новый персонаж" Click="AddEmotion_Click" Margin="0,0,6,0"/>
                    <Button Grid.Column="1" Content="⋯" Click="CharacterMenu_Click" ToolTip="Копировать, переименовать или удалить персонажа"/>
                </Grid>
                <TextBlock x:Name="EmotionImageWarning" Foreground="#F0B875" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="4,0,4,8"/>
                <Border Height="1" Background="#42505C" Margin="0,4,0,8"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                
                <Button Visibility="Collapsed" Content="Коррекция цвета" Tag="color" Click="OpenSettings_Click" Margin="0,0,0,8"/>
                <Button Visibility="Collapsed" Content="▧ Одежда · цвет и принты" Tag="clothing" Click="OpenSettings_Click" Margin="0,0,0,8"/>
                <Button Visibility="Collapsed" Content="Свет от игры" Tag="screenLight" Click="OpenSettings_Click" Margin="0,0,0,8"/>
                <StackPanel x:Name="LayerImages"/>
                <StackPanel x:Name="LegacyImages">
                <TextBlock Text="Нажмите +, чтобы добавить PNG. Можно начать с одного." FontSize="12" TextWrapping="Wrap" Foreground="#B8BEC3" Margin="4,0,4,14"/>
                <ComboBox x:Name="EyeMode" Visibility="Collapsed" Margin="0,0,0,6" SelectionChanged="EyeMode_Changed" ToolTip="Способ изображения глаз. Скрытые PNG сохраняются.">
                  <ComboBoxItem Content="Глаза на PNG персонажа"/><ComboBoxItem Content="Отдельные PNG-зрачки"/>
                </ComboBox>
                <TextBlock Text="Реакция рта" Foreground="#A7B5C8" FontSize="11" Margin="0,4,0,6"/>
                <DockPanel Margin="0,0,0,6">
                  <Button DockPanel.Dock="Right" Content="ⓘ" Width="30" Padding="0" HorizontalContentAlignment="Center" Margin="4,0,0,0" Click="MouthModeHelp_Click" ToolTip="Чем отличаются режимы? Нажмите для объяснения."/>
                  <ComboBox x:Name="MouthMode" SelectionChanged="MouthMode_Changed" ToolTip="Режим изображений выбранного персонажа">
                    <ComboBoxItem Content="Открыт / закрыт"/><ComboBoxItem Content="По громкости"/><ComboBoxItem Content="По звукам · пробный"/>
                  </ComboBox>
                </DockPanel>
                <ComboBox x:Name="MouthDriver" Margin="0,0,0,6" Visibility="Collapsed" SelectionChanged="MouthDriver_Changed">
                    <ComboBoxItem Content="По громкости"/><ComboBoxItem Content="По звукам · пробный"/>
                </ComboBox>
                <TextBlock x:Name="VowelStatus" Visibility="Collapsed" Text="Форма: обычный рот" FontSize="11" TextWrapping="Wrap" Foreground="#A7B5C8" Margin="0,0,0,8"/>
                <StackPanel x:Name="WideMouthSettings" Visibility="Collapsed" Margin="0,0,0,8">
                  <TextBlock Text="Широко открыть при:" FontSize="11"/>
                  <TextBlock FontSize="11" Text="{Binding Value, ElementName=WideMouthThreshold, StringFormat={}{0:0}% громкости}"/>
                  <Slider x:Name="WideMouthThreshold" Minimum="0" Maximum="100" Value="65" ValueChanged="WideMouthThreshold_Changed" ToolTip="Уровень для широкого рта. Настройте выше порога речи слева."/>
                </StackPanel>
                <ItemsControl x:Name="StateList">
                    <ItemsControl.GroupStyle><GroupStyle>
                      <GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Margin="4,10,0,6" Foreground="#DCE8F5"/></DataTemplate></GroupStyle.HeaderTemplate>

                    </GroupStyle></ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="SlotBorder" Background="#1A1A1A" BorderBrush="#333333"
                                    BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid Width="48" Height="48" HorizontalAlignment="Center">
                                        <Border Background="#0F0F0F" CornerRadius="4" Cursor="Hand"
                                                MouseLeftButtonDown="StateAdd_MouseDown"
                                                ToolTip="{Binding ToolTip}">
                                            <Grid>
                                                <TextBlock x:Name="PlusGlyph" Text="+" FontSize="24"
                                                           Foreground="#06E2EB" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <Image x:Name="ThumbImg" Source="{Binding Thumbnail}"
                                                       Stretch="Uniform" Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>
                                        <Button x:Name="ClearBtn" Content="×" Style="{StaticResource FlatButtonStyle}"
                                                FontSize="14" Foreground="#06E2EB" Background="#151515"
                                                Width="20" Height="20" Padding="0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Visibility="Collapsed" ToolTip="Очистить состояние"
                                                Click="StateClear_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="SlotLabel" Text="{Binding EyeCaption}" FontSize="12"
                                               Foreground="#999999" HorizontalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFilled}" Value="True">
                                    <Setter TargetName="PlusGlyph" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="ThumbImg" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="ClearBtn" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="SlotBorder" Property="BorderBrush" Value="#06E2EB"/>
                                    <Setter TargetName="SlotLabel" Property="Foreground" Value="#06E2EB"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel x:Name="VowelActions" Visibility="Collapsed" Margin="0,4,0,0">
                  <Button Content="+ Добавить звук" Click="AddVowel_Click" ToolTip="Добавить пару PNG только для нужного звука"/>
                  <Button Content="Убрать звук из набора…" Click="RemoveVowel_Click" Margin="0,4,0,0" FontSize="11" ToolTip="Скрыть звук, сохранив пути PNG для повторного добавления"/>
                </StackPanel>
                </StackPanel>
                </StackPanel>
            </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Return-from-clean-scene button (visible only when CleanSceneMode + mouse near left edge) -->
        <Button x:Name="BtnShowInterface" Content="Вернуть"
                Style="{StaticResource ToolButtonStyle}"
                Width="36" Height="60" FontSize="16" Foreground="#06E2EB"
                Background="#8817191B" BorderBrush="#06E2EB" BorderThickness="1"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"
                Visibility="Collapsed" Panel.ZIndex="30"
                ToolTip="Показать интерфейс (F8)"
                AutomationProperties.AutomationId="BtnShowInterface"
                Click="BtnShowInterface_Click"/>

            <Border x:Name="RegionHint" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="200,16,200,0"
                    Background="#F0171C24" Padding="14,10" Panel.ZIndex="11">
              <StackPanel><TextBlock Text="Обведите глаз. Внутри — перемещение, точки по краям — размер." TextWrapping="Wrap"/>
               <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Content="Применить" Click="ApplyRegion_Click" Margin="0,0,8,0"/>
                <Button Content="Отмена · Esc" Click="CancelRegion_Click"/>
               </StackPanel>
              </StackPanel>
            </Border>

            <!-- Compact overlay panel (floats over the scene) -->
            <Border x:Name="OverlayHost" Visibility="Collapsed" Panel.ZIndex="10"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="440" MaxHeight="620" Margin="12"
                    Background="#151515" BorderBrush="#06E2EB" BorderThickness="1" CornerRadius="8">
                <Grid Margin="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#101010" BorderBrush="#2A2A2A"
                            BorderThickness="0,0,0,1" CornerRadius="7,7,0,0" Padding="12,8"
                            Cursor="SizeAll" ToolTip="Перетащите заголовок, чтобы увидеть персонажа"
                            MouseLeftButtonDown="OverlayDrag_Down" MouseMove="OverlayDrag_Move" MouseLeftButtonUp="OverlayDrag_Up">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="OverlayTitle" Text="Настройки" Foreground="#06E2EB"
                                       FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button x:Name="BtnOverlayClose" Grid.Column="1" Content="×"
                                    Width="32" Height="30" Padding="0" FontSize="14"
                                    ToolTip="Закрыть панель" Click="BtnOverlayClose_Click"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="4">
                        <ContentControl x:Name="OverlayContent"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Toast -->
            <Border x:Name="ToastHost" Visibility="Collapsed" Panel.ZIndex="20"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40"
                    Background="#CC151515" BorderBrush="#06E2EB" BorderThickness="1"
                    CornerRadius="6" Padding="14,8">
                <TextBlock x:Name="ToastText" Text="" Foreground="#DDDDDD" FontSize="12"/>
            </Border>
    </Grid>
</Window>
