<UserControl x:Class="VeadotubeMy.Views.MicrophoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="400">

    <StackPanel Margin="14">

        <TextBlock Text="Устройство записи" Foreground="#DDDDDD" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ComboBox x:Name="CbDevices" Margin="0,0,0,6" SelectionChanged="CbDevices_SelectionChanged"/>
        <TextBlock x:Name="TxtCurrentDevice" Text="" Foreground="#06E2EB" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"/>
        <TextBlock x:Name="TxtNoDevices" Text="Микрофоны не найдены" Foreground="#E76F51" FontSize="12" Margin="0,0,0,10" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Button x:Name="BtnStartStop" Content="Старт" Width="110" Click="BtnStartStop_Click"/>
            <Button x:Name="BtnRefresh" Content="Обновить список" Width="130" Margin="8,0,0,0" Click="BtnRefresh_Click"/>
        </StackPanel>

        <TextBlock Text="Чувствительность" Foreground="#DDDDDD" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Slider x:Name="SliderSensitivity" Minimum="0.5" Maximum="8" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" Width="220"/>
            <TextBlock x:Name="TxtSensitivity" Text="×1,0" Foreground="#06E2EB" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="Для тихой речи попробуйте ×2. Усиливает шкалу и реакцию рта только в программе; громкость Windows не меняется. Усиливается и фоновый шум — после настройки проверьте порог. Точность распознавания гласных не меняет."
                   Foreground="#BBBBBB" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <TextBlock Text="Порог открытия рта" Foreground="#DDDDDD" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Slider x:Name="SliderThreshold" Minimum="0" Maximum="100" Value="20" Width="220"/>
            <TextBlock x:Name="TxtThreshold" Text="20%" Foreground="#06E2EB" FontSize="12" FontWeight="Bold"
                       Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="Рот открывается, когда уровень микрофона достигает порога."
                   Foreground="#BBBBBB" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <TextBlock Text="Задержка закрытия рта" Foreground="#DDDDDD" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Slider x:Name="SliderCloseDelay" Minimum="0" Maximum="2000" Value="200" TickFrequency="50" IsSnapToTickEnabled="True" Width="220"/>
            <TextBlock x:Name="TxtCloseDelay" Text="200 мс" Foreground="#06E2EB" FontSize="12" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="Рот остаётся открытым на коротких паузах. 0 мс — закрывать сразу. Моргание работает независимо."
                   Foreground="#BBBBBB" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <Expander Header="Обучить гласные моему голосу" Expanded="CalibrationExpanded" Collapsed="CalibrationCollapsed" Margin="0,0,0,12"/>
        <TextBlock Text="Уровень микрофона" Foreground="#DDDDDD" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ProgressBar x:Name="PbLevel" Minimum="0" Maximum="100" Value="0" Height="14"
                     Foreground="#06E2EB" Background="#0F0F0F"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock x:Name="TxtLevelPercent" Text="0%" Foreground="#06E2EB" FontSize="12" FontWeight="Bold"/>
            <TextBlock x:Name="TxtState" Text="Остановлено" Foreground="#BBBBBB" FontSize="12" FontWeight="SemiBold" Margin="12,0,0,0"/>
        </StackPanel>

    </StackPanel>
</UserControl>
