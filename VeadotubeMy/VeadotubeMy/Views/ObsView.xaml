<UserControl x:Class="VeadotubeMy.Views.ObsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="400">

    <StackPanel Margin="14">

        <TextBlock Text="Фон сцены" Foreground="#F2F2F2" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Text="Выберите готовый цвет или настройте свой." Foreground="#B8BEC3" FontSize="12" Margin="0,0,0,16"/>

        <TextBlock Text="Быстрые цвета" Foreground="#F2F2F2" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Tag="#00FF00" Click="BtnQuickColor_Click" Style="{StaticResource SwatchButtonStyle}"
                    Background="#00FF00" ToolTip="Зелёный хромакей" AutomationProperties.Name="Зелёный хромакей"/>
            <Button Tag="#000000" Click="BtnQuickColor_Click" Style="{StaticResource SwatchButtonStyle}"
                    Background="#000000" ToolTip="Чёрный" AutomationProperties.Name="Чёрный"/>
            <Button Tag="#FFFFFF" Click="BtnQuickColor_Click" Style="{StaticResource SwatchButtonStyle}"
                    Background="#FFFFFF" ToolTip="Белый" AutomationProperties.Name="Белый"/>
            <Button Tag="#808080" Click="BtnQuickColor_Click" Style="{StaticResource SwatchButtonStyle}"
                    Background="#808080" ToolTip="Серый" AutomationProperties.Name="Серый"/>
            <Button Tag="#0000FF" Click="BtnQuickColor_Click" Style="{StaticResource SwatchButtonStyle}"
                    Background="#0000FF" ToolTip="Синий хромакей" AutomationProperties.Name="Синий хромакей"/>
        </WrapPanel>

        <TextBlock Text="Палитра" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Grid x:Name="Palette" Height="150" Background="Red" MouseLeftButtonDown="Palette_Down" MouseMove="Palette_Move" MouseLeftButtonUp="Palette_Up" Margin="0,0,0,8" Cursor="Cross">
          <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
          <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="Black" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
        </Grid>
        <TextBlock Text="Оттенок" FontSize="11"/>
        <Slider x:Name="Hue" Minimum="0" Maximum="360" ValueChanged="Hue_Changed" Margin="0,4,0,12"/>
        <TextBlock Text="Последние цвета" FontSize="11"/>
        <WrapPanel x:Name="RecentColors" Margin="0,4,0,12"/>
        <TextBlock Text="HEX цвета" Foreground="#F2F2F2" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBox x:Name="TxtHex" FontSize="13" Padding="4" Margin="0,0,0,12" AutomationProperties.Name="HEX цвета"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Предпросмотр:" Foreground="#B8BEC3" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Border x:Name="PreviewSwatch" Width="44" Height="26" BorderBrush="#06E2EB" BorderThickness="1" CornerRadius="4"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnApply" Content="Применить" Width="110" Click="BtnApply_Click"/>
            <Button x:Name="BtnReset" Content="Сбросить" Width="110" Margin="10,0,0,0" Click="BtnReset_Click"/>
        </StackPanel>

        <TextBlock x:Name="TxtHint" Text="" FontSize="12" Foreground="#B8BEC3"/>
    </StackPanel>
</UserControl>
