<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Dekotube</AssemblyName>
    <RootNamespace>Dekotube</RootNamespace>
    <Product>Dekotube</Product>
    <Title>Dekotube</Title>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Shaders/ColorCorrection.ps" />
    <Resource Include="Shaders/LayeredArms.ps" />
    <Resource Include="Shaders/CustomArms.ps" />
    <PackageReference Include="NAudio" Version="3.1.0" />
  </ItemGroup>

</Project>
