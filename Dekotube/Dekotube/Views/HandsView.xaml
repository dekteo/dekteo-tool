<UserControl x:Class="Dekotube.Views.HandsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="16">
  <TextBlock Text="Руки и устройства" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <TextBlock Text="Загрузите PNG рук в спокойном состоянии и при нажатии. Они появятся поверх сцены; файлы можно заменить в любой момент." TextWrapping="Wrap" Margin="0,0,0,14"/>
  <TextBlock Text="Режим выбора устройства" Foreground="#AAA" FontSize="12"/>
  <ComboBox x:Name="ModeList" SelectedValuePath="Tag" SelectionChanged="ModeList_SelectionChanged" Margin="0,4,0,12">
   <ComboBoxItem Content="Автоматически по последнему вводу" Tag="auto"/>
   <ComboBoxItem Content="Клавиатура и мышь" Tag="keyboard_mouse"/>
   <ComboBoxItem Content="Геймпад" Tag="gamepad"/>
  </ComboBox>
  <Button Content="Выбрать PNG: руки в покое" Click="Idle_Click" Margin="0,0,0,8"/>
  <Button Content="Выбрать PNG: руки активны" Click="Active_Click" Margin="0,0,0,8"/>
  <TextBlock x:Name="Status" Text="Файлы не выбраны" Foreground="#06E2EB" TextWrapping="Wrap"/>
  <TextBlock x:Name="InputStatus" Text="Последний ввод: нет" Foreground="#B8BEC3" Margin="0,12,0,0"/>
 </StackPanel>
</UserControl>
